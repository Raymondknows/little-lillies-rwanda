{
  "buildCommand": "npm run build",
  "outputDirectory": ".next",
  "framework": "nextjs",
  "env": [
    {
      "key": "NEXT_PUBLIC_API_URL",
      "value": "https://www.schoolbase.live/api",
      "target": ["production", "preview", "development"]
    },
    {
      "key": "BACKEND_URL",
      "value": "https://www.schoolbase.live/api",
      "target": ["production", "preview"]
    }
  ]
}
